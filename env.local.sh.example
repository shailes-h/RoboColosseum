# Copy to env.local.sh (gitignored) and adjust for your machine.
# Shared/NFS filesystems are very slow for python envs and video decoding: put envs and a staged
# copy of the data on node-local disk (see scripts/data/stage.sh).
# export RC_ENVS=/tmp/rc_envs
# export RC_DATA=/tmp/rc_data
# export RC_OUTPUTS=/shared/fast/RoboColosseum/outputs
# export WANDB_ENTITY=my-team
# export CONDA_SH=$HOME/miniconda3/etc/profile.d/conda.sh   # needed for LingBot (conda env)
# export FLASH_ATTN_WHEEL=/path/to/flash_attn-2.8.3-cp312-cp312-linux_x86_64.whl  # LingBot; prebuilt for your glibc/CUDA
